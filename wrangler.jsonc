
{
  "$schema": "https://schema.workers.dev/wrangler.json",
  "name": "sahdong",
  "pages_build_output_dir": "./public",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sahdong-db",
      "database_id": "8c292015-8dbb-49f2-923b-3f651acfd26d",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GALLERY",
      "bucket_name": "sahdong-gallery"
    },
    {
      "binding": "MUSIC",
      "bucket_name": "sahdong-music"
    }
  ]
}

// Tambahkan ini ke wrangler.json (sejajar dengan "d1_databases" / "r2_buckets"):
// Cron "0 19 * * *" = tiap hari 19:00 UTC = 02:00 WIB.
//
// "triggers": {
//   "crons": ["0 19 * * *"]
// }
//
// Contoh wrangler.json lengkapnya:
// {
//   "$schema": "https://schema.workers.dev/wrangler.json",
//   "name": "sahdong",
//   "pages_build_output_dir": "./public",
//   "triggers": { "crons": ["0 19 * * *"] },
//   "d1_databases": [ ... ],
//   "r2_buckets": [ ... ]
// }
